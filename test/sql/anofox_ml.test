# name: test/sql/anofox_ml.test
# description: anofox_ml basics: estimators, fit, predict
# group: [anofox_ml]

require anofox_ml

statement ok
SET anofox_telemetry_enabled = false;

query I
SELECT count(*) > 100 FROM ml_estimators();
----
true

query I
SELECT count(*) FROM ml_estimators() WHERE kind = 'RandomForestClassifier';
----
1

statement ok
CREATE TABLE train AS
SELECT g, i::DOUBLE AS a, (i % 7)::DOUBLE AS b, CASE WHEN i % 20 >= 10 THEN 1.0 ELSE 0.0 END AS y
FROM range(400) t(i), (VALUES ('x'), ('y')) v(g);

statement ok
CREATE TABLE models AS
SELECT g, ml_fit_agg('DecisionTreeClassifier', y, [a % 20, b]) AS model FROM train GROUP BY g;

query I
SELECT count(*) FROM models WHERE model IS NOT NULL;
----
2

query I
SELECT DISTINCT ml_model_kind(model) FROM models;
----
DecisionTreeClassifier

# A fully grown tree reproduces its training labels.
query I
SELECT count(*) FROM train JOIN models USING (g) WHERE ml_predict(model, [a % 20, b]) <> y;
----
0

statement ok
CREATE TABLE rf AS
SELECT ml_fit_agg('RandomForestClassifier', y, [a % 20, b], '{"n_estimators": 20, "max_depth": 4}') AS model FROM train;

query I
SELECT avg(CASE WHEN ml_predict(model, [a % 20, b]) = y THEN 1 ELSE 0 END) > 0.9 FROM train, rf;
----
true

statement error
SELECT ml_fit_agg('NoSuchModel', y, [a]) FROM train;
----
ml_fit_agg

statement error
SELECT ml_predict('not a model'::BLOB, [1.0]);
----
not an anofox_ml model BLOB

# ---------------------------------------------------------------- model info

query IIIII
SELECT i.kind, i.n_features, i.classes, list_contains(i.capabilities, 'predict_proba'), i.format_version
FROM (SELECT ml_model_info(model) AS i FROM rf);
----
RandomForestClassifier	2	[0.0, 1.0]	true	2

query I
SELECT ml_model_info(model).params LIKE '%"n_estimators":20%' FROM rf;
----
true

query I
SELECT ml_model_info(NULL::BLOB) IS NULL;
----
true

# ------------------------------------------------------ predict_proba & co.

# Probabilities sum to one and their argmax is the predicted class.
query II
SELECT bool_and(abs(list_sum(p) - 1) < 1e-9),
       bool_and(ml_model_info(model).classes[list_position(p, list_max(p))] = ml_predict(model, [a % 20, b]))
FROM (SELECT model, a, b, ml_predict_proba(model, [a % 20, b]) AS p FROM train, rf);
----
true	true

statement error
SELECT ml_predict_proba(ml_fit_agg('DecisionTreeRegressor', y, [a % 20, b]), [1.0, 2.0]) FROM train;
----
does not support predict_proba

statement error
SELECT ml_predict(model, [a % 20, b, 1.0]) FROM rf, train;
----
fitted on 2 features, got 3

# ------------------------------------------------- unsupervised: no target

statement ok
CREATE TABLE scaler AS SELECT ml_fit_agg('StandardScaler', [a, b]) AS model FROM train;

query II
SELECT ml_model_info(model).classes IS NULL, len(ml_model_info(model).capabilities) > 0 FROM scaler;
----
true	true

# Standardised columns have mean 0 and population variance 1.
query II
SELECT round(avg(t[1]), 9) = 0, round(var_pop(t[2]), 9) FROM (SELECT ml_transform(model, [a, b]) AS t FROM train, scaler);
----
true	1.0

# inverse_transform undoes transform.
query I
SELECT bool_and(abs(ml_inverse_transform(model, ml_transform(model, [a, b]))[1] - a) < 1e-9) FROM train, scaler;
----
true

statement error
SELECT ml_predict(model, [a, b]) FROM train, scaler;
----
does not support predict

query I
SELECT count(DISTINCT ml_predict(m, [a % 20, b]))
FROM train, (SELECT ml_fit_agg('KMeans', [a % 20, b], '{"n_clusters": 3, "seed": 0}') AS m FROM train);
----
3

# ------------------------------------------- per-row clustering / outliers

# Two separated blobs per group plus one far outlier (id 20) and one row
# with a NULL feature list (id 21).
statement ok
CREATE TABLE pts AS
SELECT g, i AS id,
       CASE WHEN i = 21 THEN NULL
            WHEN i = 20 THEN [50.0, -50.0]
            WHEN i < 10 THEN [i * 0.1, i * 0.1]
            ELSE [10.0 + (i - 10) * 0.1, 10.0 - (i - 10) * 0.1] END AS x
FROM range(22) t(i), (VALUES ('p'), ('q')) v(g);

statement ok
CREATE TABLE clustered AS
SELECT g, unnest(list(id ORDER BY id)) AS id,
       unnest(ml_cluster_agg('Dbscan', x, '{"eps": 0.5, "min_samples": 3}' ORDER BY id)) AS label
FROM pts GROUP BY g;

query III
SELECT g, count(DISTINCT label) FILTER (WHERE id < 20), max(label) FILTER (WHERE id < 10) <> max(label) FILTER (WHERE id BETWEEN 10 AND 19)
FROM clustered GROUP BY g ORDER BY g;
----
p	2	true
q	2	true

query III
SELECT g, max(label) FILTER (WHERE id = 20), bool_and(label IS NULL) FILTER (WHERE id = 21)
FROM clustered GROUP BY g ORDER BY g;
----
p	-1	true
q	-1	true

# KMeans: labels of the fit.
query I
SELECT len(list_distinct(ml_cluster_agg('KMeans', x, '{"n_clusters": 2, "seed": 0}'))) FROM pts WHERE id < 20;
----
2

# The outlier has the lowest score (higher = more normal, as in scikit-learn).
query I
SELECT arg_min(id, s) FROM (
    SELECT unnest(list(id ORDER BY id)) AS id,
           unnest(ml_outlier_score_agg('LocalOutlierFactor', x, '{"n_neighbors": 5}' ORDER BY id)) AS s
    FROM pts WHERE g = 'p')
WHERE s IS NOT NULL;
----
20

query I
SELECT len(ml_outlier_score_agg('IsolationForest', x, '{"seed": 0}')) FROM pts WHERE g = 'p' AND x IS NOT NULL;
----
21

statement error
SELECT ml_cluster_agg('StandardScaler', x) FROM pts;
----
supports none of

# Sample weights: weighted mean of [0, 10] with weights [3, 1] is 2.5.
query I
SELECT ml_transform(ml_fit_agg('StandardScaler', [v], '{}', w), [2.5])[1] FROM (VALUES (0.0, 3.0), (10.0, 1.0)) t(v, w);
----
0.0

# Unweighted, the mean is 5.
query I
SELECT ml_transform(ml_fit_agg('StandardScaler', [v]), [5.0])[1] FROM (VALUES (0.0), (10.0)) t(v);
----
0.0

# Rows with a NULL weight are skipped.
query I
SELECT ml_transform(ml_fit_agg('StandardScaler', [v], '{}', w), [2.5])[1] FROM (VALUES (0.0, 3.0), (10.0, 1.0), (99.0, NULL)) t(v, w);
----
0.0

# A supervised weighted fit: a weighted tree stump follows the heavier rows.
query I
SELECT ml_predict(ml_fit_agg('DecisionTreeRegressor', y, [x], '{"max_depth": 0}', w), [0.0])
FROM (VALUES (0.0, 0.0, 1.0), (0.0, 10.0, 3.0)) t(x, y, w);
----
7.5

statement error
SELECT ml_fit_agg('KnnRegressor', y, [a], '{}', 1.0) FROM train;
----
sample_weight

# ml_fit_transform_agg: training embeddings, one DOUBLE[] per row.
query III
SELECT len(e), len(e[1]), list_bool_and([len(r) = 2 for r in e])
FROM (SELECT ml_fit_transform_agg('Isomap', x, '{"n_neighbors": 5, "n_components": 2}' ORDER BY id) AS e
      FROM pts WHERE g = 'p' AND x IS NOT NULL);
----
21	2	true

# Kinds without a stored embedding fall back to transform.
query I
SELECT ml_fit_transform_agg('StandardScaler', [v] ORDER BY v) FROM (VALUES (1.0), (3.0)) t(v);
----
[[-1.0], [1.0]]

# Supervised: TargetEncoder returns its cross-fitted training encoding.
query I
SELECT len(ml_fit_transform_agg('TargetEncoder', y, [a % 4])) FROM train WHERE g = 'x';
----
400

# NULL feature lists give a NULL row.
query I
SELECT ml_fit_transform_agg('StandardScaler', x ORDER BY id)[1] IS NULL
FROM (VALUES (1, NULL::DOUBLE[]), (2, [1.0]), (3, [3.0])) t(id, x);
----
true

# ml_model_fitted: the fitted state as JSON (arrays as {"v", "dim", "data"}).
query II
SELECT f LIKE '{"coef":{"v":1,"dim":[1],"data":[%]},"intercept":%}', f LIKE '{"centroids":%'
FROM (SELECT ml_model_fitted(ml_fit_agg('OlsRegressor', 2 * v + 1, [v])) AS f FROM range(10) t(v));
----
true	false

query I
SELECT ml_model_fitted(ml_fit_agg('KMeans', [v], '{"n_clusters": 2, "seed": 0}')) LIKE '{"centroids":{"v":1,"dim":[2,1],%'
FROM range(10) t(v);
----
true

statement error
SELECT ml_model_fitted('garbage'::BLOB);
----
not an anofox_ml model

# A NULL inside a feature list: the row is skipped when fitting and predicts NULL.
query II
SELECT ml_predict(m, [1.0, NULL]) IS NULL, ml_predict(m, [1.0, 1.0]) FROM (
    SELECT ml_fit_agg('OlsRegressor', y, [a, b]) AS m
    FROM (VALUES (1.0, 0.0, 1.0), (2.0, 1.0, 1.0), (3.0, 2.0, 1.0), (99.0, NULL, 1.0)) t(y, a, b));
----
true	2.0

query I
SELECT ml_cluster_agg('KMeans', x, '{"n_clusters": 2}' ORDER BY id)[2] IS NULL
FROM (VALUES (1, [0.0]), (2, [NULL::DOUBLE]), (3, [5.0]), (4, [0.1]), (5, [5.1])) t(id, x);
----
true

# Memory guard: rows x features per group.
statement ok
SET anofox_ml_max_fit_values = 100;

statement ok
SELECT ml_fit_agg('OlsRegressor', i::DOUBLE, [i::DOUBLE, 1.0]) FROM range(50) t(i);

statement error
SELECT ml_fit_agg('OlsRegressor', i::DOUBLE, [i::DOUBLE, 1.0]) FROM range(51) t(i);
----
anofox_ml_max_fit_values

# The limit applies per group, and to the per-row aggregates.
statement ok
SELECT i % 2 AS g, ml_fit_agg('OlsRegressor', i::DOUBLE, [i::DOUBLE, 1.0]) FROM range(100) t(i) GROUP BY g;

statement error
SELECT ml_cluster_agg('KMeans', [i::DOUBLE, 1.0]) FROM range(51) t(i);
----
anofox_ml_max_fit_values

# USING SAMPLE keeps a fit under the limit.
statement ok
SELECT ml_fit_agg('OlsRegressor', i::DOUBLE, [i::DOUBLE, 1.0]) FROM (FROM range(1000) t(i) USING SAMPLE 40 ROWS);

statement ok
SET anofox_ml_max_fit_values = 0;

statement ok
SELECT ml_fit_agg('OlsRegressor', i::DOUBLE, [i::DOUBLE, 1.0]) FROM range(1000) t(i);

statement ok
RESET anofox_ml_max_fit_values;

# Parallel fits: a single fit uses the shared pool, and the model does not
# depend on the thread count.
statement ok
CREATE TABLE par AS SELECT i AS id, (hash(i) % 1000) / 100.0 AS a, (hash(i, 'b') % 1000) / 100.0 AS b FROM range(3000) t(i);

statement ok
SET anofox_ml_threads = 1;

statement ok
CREATE TABLE seq AS SELECT ml_fit_agg('RandomForestRegressor', 2 * a + b, [a, b], '{"n_estimators": 20}') AS rf,
    ml_fit_agg('KMeans', [a, b], '{"n_clusters": 4}') AS km, ml_fit_agg('IsolationForest', [a, b]) AS iso FROM par;

statement ok
SET anofox_ml_threads = 8;

query III
SELECT seq.rf = ml_fit_agg('RandomForestRegressor', 2 * a + b, [a, b], '{"n_estimators": 20}'),
       seq.km = ml_fit_agg('KMeans', [a, b], '{"n_clusters": 4}'),
       seq.iso = ml_fit_agg('IsolationForest', [a, b])
FROM par, seq GROUP BY seq.rf, seq.km, seq.iso;
----
true	true	true

statement ok
RESET anofox_ml_threads;

# Fitted arrays.
query II
SELECT round(c.coef[1][1], 9), round(c.intercept[1], 9)
FROM (SELECT ml_coefficients(ml_fit_agg('OlsRegressor', 2 * i + 1, [i::DOUBLE])) AS c FROM range(50) t(i));
----
2.0	1.0

query II
SELECT len(c.coef), len(c.intercept) FROM (SELECT ml_coefficients(ml_fit_agg('LogisticRegressor', (i % 3)::DOUBLE, [i::DOUBLE, (i % 5)::DOUBLE])) AS c FROM range(60) t(i));
----
3	3

query I
SELECT list_sort(ml_cluster_centers(ml_fit_agg('KMeans', [(i % 2) * 10.0], '{"n_clusters": 2}'))) FROM range(20) t(i);
----
[[0.0], [10.0]]

query I
SELECT abs(list_sum(ml_explained_variance_ratio(ml_fit_agg('Pca', [i::DOUBLE, (i % 3)::DOUBLE]))) - 1) < 1e-9 FROM range(20) t(i);
----
true

statement error
SELECT ml_coefficients(ml_fit_agg('DecisionTreeRegressor', i::DOUBLE, [i::DOUBLE])) FROM range(10) t(i);
----
has no coef / weights

# predict_log_proba: native for naive Bayes, LDA / QDA, Logistic, Svc, GMM
# (anofox-ml 0.5; finite where predict_proba underflows to 0), else
# ln(predict_proba)
query II
SELECT list_bool_and(list_transform(list_zip(ml_predict_log_proba(m, x), ml_predict_proba(m, x)), lambda p: CASE WHEN p[2] = 0 THEN true ELSE abs(p[1] - ln(p[2])) < 1e-9 END)),
       list_bool_and(list_transform(ml_predict_log_proba(m, [100.0]), lambda v: isfinite(v)))
FROM (SELECT ml_fit_agg('GaussianNB', (i % 3)::DOUBLE, [i::DOUBLE]) AS m FROM range(30) t(i)), (SELECT [3.0] AS x);
----
true	true

query I
SELECT list_bool_and(list_transform(list_zip(ml_predict_log_proba(m, [3.0]), ml_predict_proba(m, [3.0])),
    lambda p: CASE WHEN p[2] = 0 THEN p[1] = '-inf'::DOUBLE ELSE abs(p[1] - ln(p[2])) < 1e-12 END))
FROM (SELECT ml_fit_agg('RandomForestClassifier', (i % 3)::DOUBLE, [i::DOUBLE], '{"n_estimators": 5, "seed": 0}') AS m FROM range(30) t(i));
----
true

# Kinds added in anofox-ml 0.3 / 0.4 fit and predict through the generic path.
statement ok
CREATE TABLE k04 AS SELECT i, (hash(i) % 1000) / 100.0 AS a, (hash(i, 'b') % 1000) / 100.0 AS b,
    CASE WHEN (hash(i) % 1000) / 100.0 + (hash(i, 'b') % 1000) / 100.0 > 10 THEN 'hi' ELSE 'lo' END AS lab FROM range(400) t(i);

query I
SELECT count(*) FROM ml_estimators() WHERE kind IN ('CatBoostRegressor', 'OneVsRestClassifier', 'SplitConformalRegressor', 'LedoitWolf', 'KernelDensity');
----
5

query I
SELECT abs(ml_predict(ml_fit_agg('SplitConformalRegressor', a + b, [a, b]), [1.0, 2.0]) - 3) < 1e-9 FROM k04;
----
true

query II
SELECT ml_predict(m, [9.0, 9.0]), ml_predict(m, [0.5, 0.5]) FROM (SELECT ml_fit_agg('OneVsRestClassifier', lab, [a, b]) AS m FROM k04);
----
0.0	1.0

query I
SELECT ml_predict_proba(m, [9.0, 9.0])[1] > 0.5 FROM (SELECT ml_fit_agg('CatBoostClassifier', lab, [a, b], '{"iterations": 30}') AS m FROM k04);
----
true

# ExtraTreesClassifier has predict_proba since 0.3.
query I
SELECT list_contains(ml_model_info(ml_fit_agg('ExtraTreesClassifier', lab, [a, b], '{"n_estimators": 5}')).capabilities, 'predict_proba') FROM k04;
----
true

# Feature importances (DynModel::feature_importances, anofox-ml 0.4).
query II
SELECT len(fi), abs(list_sum(fi) - 1) < 1e-9 FROM (SELECT ml_feature_importances(ml_fit_agg('RandomForestRegressor', 3 * a + 0.1 * b, [a, b], '{"n_estimators": 10, "seed": 0}')) AS fi FROM k04);
----
2	true

query I
SELECT fi[1] > fi[2] FROM (SELECT ml_feature_importances(ml_fit_agg('HistGradientBoostingRegressor', 3 * a + 0.1 * b, [a, b])) AS fi FROM k04);
----
true

query I
SELECT len(ml_feature_importances(ml_fit_agg('ExtraTreesClassifier', lab, [a, b], '{"n_estimators": 5}'))) FROM k04;
----
2

query I
SELECT ml_feature_importances(NULL::BLOB) IS NULL;
----
true

statement error
SELECT ml_feature_importances(ml_fit_agg('OlsRegressor', a + b, [a, b])) FROM k04;
----
feature_importances

# Training statistics in ml_model_info; NULL where the model has none.
query III
SELECT i.n_iter > 0, i.inertia > 0, i.oob_score IS NULL FROM (SELECT ml_model_info(ml_fit_agg('KMeans', [a, b], '{"n_clusters": 3}')) AS i FROM k04);
----
true	true	true

query II
SELECT i.oob_score BETWEEN 0 AND 1, i.n_iter IS NULL FROM (SELECT ml_model_info(ml_fit_agg('RandomForestRegressor', a + b, [a, b], '{"n_estimators": 20, "oob_score": true, "seed": 0}')) AS i FROM k04);
----
true	true

query I
SELECT ml_model_info(ml_fit_agg('LogisticRegressor', lab, [a, b])).n_iter > 0 FROM k04;
----
true

# The 0.4 kinds RidgeClassifier and NearestCentroid work with the accessors.
query I
SELECT len(ml_coefficients(ml_fit_agg('RidgeClassifier', lab, [a, b])).coef[1]) FROM k04;
----
2

query I
SELECT len(ml_cluster_centers(ml_fit_agg('NearestCentroid', lab, [a, b]))) FROM k04;
----
2

# Staged predictions of the boosting kinds: one value per stage, the last
# equals ml_predict (anofox-ml 0.4).
statement ok
CREATE TABLE es AS SELECT i, (hash(i) % 1000) / 100.0 AS a, (hash(i, 'b') % 1000) / 100.0 AS b,
    sin((hash(i) % 1000) / 100.0) * 3 + (hash(i, 'b') % 1000) / 100.0 + (hash(i, 'n') % 1000) / 250.0 AS y,
    i % 5 = 0 AS val
FROM range(2000) t(i);

query III
SELECT kind, len(sp), abs(sp[-1] - p) < 1e-12 FROM (
    SELECT kind, ml_staged_predict(m, [1.0, 2.0]) AS sp, ml_predict(m, [1.0, 2.0]) AS p
    FROM (SELECT kind, ml_fit_agg(kind, y, [a, b], '{"n_estimators": 30}') AS m
          FROM es, (VALUES ('GradientBoostingRegressor'), ('HistGradientBoostingRegressor')) v(kind) GROUP BY kind))
ORDER BY kind;
----
GradientBoostingRegressor	30	true
HistGradientBoostingRegressor	30	true

# classifiers: the predicted class (label index) per stage
query I
SELECT list_distinct(ml_staged_predict(ml_fit_agg('GradientBoostingClassifier', CASE WHEN y > 5 THEN 'hi' ELSE 'lo' END, [a, b], '{"n_estimators": 7}'), [9.0, 9.0])) FROM es;
----
[0.0]

statement error
SELECT ml_staged_predict(ml_fit_agg('RandomForestRegressor', y, [a, b], '{"n_estimators": 5}'), [1.0, 2.0]) FROM es;
----
staged_predict

# Early stopping on an explicit validation set: stops before n_estimators,
# depends on which rows validate, and is deterministic.
query III
SELECT n1 < 500, n1 = n2, n1 <> n3 FROM (
    SELECT len(ml_staged_predict(m1, [1.0, 2.0])) AS n1, len(ml_staged_predict(m2, [1.0, 2.0])) AS n2, len(ml_staged_predict(m3, [1.0, 2.0])) AS n3
    FROM (SELECT ml_fit_with_validation_agg('HistGradientBoostingRegressor', y, [a, b], val, p) AS m1,
                 ml_fit_with_validation_agg('HistGradientBoostingRegressor', y, [a, b], val, p) AS m2,
                 ml_fit_with_validation_agg('HistGradientBoostingRegressor', y, [a, b], i % 5 = 1, p) AS m3
          FROM es, (SELECT '{"n_estimators": 500, "early_stopping": "Enabled", "learning_rate": 0.5, "n_iter_no_change": 5}' AS p)));
----
true	true	true

query I
SELECT ml_model_info(ml_fit_with_validation_agg('HistGradientBoostingClassifier', CASE WHEN y > 5 THEN 'hi' ELSE 'lo' END, [a, b], val, '{"n_estimators": 3}')).labels FROM es;
----
[hi, lo]

statement error
SELECT ml_fit_with_validation_agg('OlsRegressor', y, [a, b], val) FROM es;
----
does not support fit_with_validation

statement error
SELECT ml_fit_with_validation_agg('HistGradientBoostingRegressor', y, [a, b], false) FROM es;
----
needs both training and validation rows

# Warm start (anofox-ml 0.4): 100 trees + 100 more on the same rows equal a
# 200-tree fit, for gradient boosting, HGB and LGBM.
statement ok
CREATE TABLE ws AS SELECT i, (hash(i) % 1000) / 100.0 AS a, (hash(i, 'b') % 1000) / 100.0 AS b,
    sin((hash(i) % 1000) / 100.0) * 3 + (hash(i, 'b') % 1000) / 100.0 AS y FROM range(1000) t(i);

statement ok
CREATE TABLE ws_models AS SELECT kind, ml_fit_agg(kind, y, [a, b], '{"n_estimators": 100}') AS m100,
    ml_fit_agg(kind, y, [a, b], '{"n_estimators": 200}') AS m200
FROM ws, (VALUES ('GradientBoostingRegressor'), ('HistGradientBoostingRegressor'), ('LgbmRegressor')) v(kind) GROUP BY kind;

query III
SELECT kind, len(ml_staged_predict(w, [1.0, 1.0])), max(abs(ml_predict(w, [a, b]) - ml_predict(m200, [a, b]))) < 1e-12
FROM (SELECT kind, m200, ml_warm_start_agg(m100, y, [a, b], '{"n_estimators": 200}') AS w FROM ws_models, ws GROUP BY kind, m100, m200), ws
GROUP BY ALL ORDER BY kind;
----
GradientBoostingRegressor	200	true
HistGradientBoostingRegressor	200	true
LgbmRegressor	200	true

# string labels carry over; new rows must use the model's labels
query I
SELECT ml_model_info(ml_warm_start_agg(m, CASE WHEN y > 5 THEN 'hi' ELSE 'lo' END, [a, b], '{"n_estimators": 20}')).labels
FROM (SELECT ml_fit_agg('GradientBoostingClassifier', CASE WHEN y > 5 THEN 'hi' ELSE 'lo' END, [a, b], '{"n_estimators": 10}') AS m FROM ws), ws GROUP BY m;
----
[hi, lo]

statement error
SELECT ml_warm_start_agg(m, 'zebra', [a, b]) FROM (SELECT ml_fit_agg('GradientBoostingClassifier', CASE WHEN y > 5 THEN 'hi' ELSE 'lo' END, [a, b], '{"n_estimators": 10}') AS m FROM ws), ws GROUP BY m;
----
not a label of the model

statement error
SELECT ml_warm_start_agg(m, y, [a, b]) FROM (SELECT ml_fit_agg('RandomForestRegressor', y, [a, b], '{"n_estimators": 5}') AS m FROM ws), ws GROUP BY m;
----
does not support warm_start

statement error
SELECT ml_warm_start_agg(m, y, [a]) FROM (SELECT ml_fit_agg('GradientBoostingRegressor', y, [a, b], '{"n_estimators": 5}') AS m FROM ws), ws GROUP BY m;
----
fitted on 2 features

statement error
SELECT ml_warm_start_agg(m, y, [a, b], '{"n_trees": 5}') FROM (SELECT ml_fit_agg('GradientBoostingRegressor', y, [a, b], '{"n_estimators": 5}') AS m FROM ws), ws GROUP BY m;
----
n_trees

# ml_estimators lists each kind's methods; a missing method names the kinds that have it
query II
SELECT list_contains(capabilities, 'predict_proba'), list_contains(capabilities, 'feature_importances') FROM ml_estimators() WHERE kind = 'RandomForestClassifier';
----
true	true

query I
SELECT bool_and(len(capabilities) > 0) FROM ml_estimators();
----
true

statement error
SELECT ml_predict_proba(ml_fit_agg('OlsRegressor', i::DOUBLE, [i::DOUBLE]), [1.0]) FROM range(5) t(i);
----
OlsRegressor does not support predict_proba (it supports: predict

statement error
SELECT ml_staged_predict(ml_fit_agg('OlsRegressor', i::DOUBLE, [i::DOUBLE]), [1.0]) FROM range(5) t(i);
----
WHERE list_contains(capabilities, 'staged_predict')

# partial_fit (anofox-ml 0.5): two batches give the same model as one fit
statement ok
CREATE TABLE pf AS SELECT i, [(hash(i) % 1000) / 100.0, (hash(i, 'b') % 1000) / 100.0] AS x,
    CASE WHEN (hash(i) % 1000) / 100.0 > 5 THEN 'hi' ELSE 'lo' END AS lab FROM range(400) t(i);

query I
WITH m1 AS (SELECT ml_fit_agg('GaussianNB', lab, x) AS m FROM pf WHERE i < 200),
     m2 AS (SELECT ml_partial_fit_agg(m, lab, x) AS m FROM pf, m1 WHERE i >= 200 GROUP BY m),
     mf AS (SELECT ml_fit_agg('GaussianNB', lab, x) AS m FROM pf)
SELECT max(abs(ml_predict_proba(m2.m, x)[1] - ml_predict_proba(mf.m, x)[1])) < 1e-9 FROM pf, m2, mf;
----
true

query I
WITH m1 AS (SELECT ml_fit_agg('StandardScaler', x) AS m FROM pf WHERE i < 150),
     m2 AS (SELECT ml_partial_fit_agg(m, x) AS m FROM pf, m1 WHERE i >= 150 GROUP BY m),
     mf AS (SELECT ml_fit_agg('StandardScaler', x) AS m FROM pf)
SELECT max(abs(ml_transform(m2.m, x)[2] - ml_transform(mf.m, x)[2])) < 1e-9 FROM pf, m2, mf;
----
true

query I
SELECT ml_predict_label(ml_partial_fit_agg(m, lab, x), [9.0, 1.0]) FROM pf, (SELECT ml_fit_agg('SgdClassifier', lab, x) AS m FROM pf WHERE i < 200) GROUP BY m;
----
hi

statement error
SELECT ml_partial_fit_agg(m, 'zebra', x) FROM pf, (SELECT ml_fit_agg('GaussianNB', lab, x) AS m FROM pf) GROUP BY m;
----
not a label of the model

statement error
SELECT ml_partial_fit_agg(m, x[1], x) FROM pf, (SELECT ml_fit_agg('RandomForestRegressor', x[1], x, '{"n_estimators": 3}') AS m FROM pf) GROUP BY m;
----
does not support partial_fit

# MLP warm start (anofox-ml 0.5) through ml_warm_start_agg
query I
SELECT ml_model_info(ml_warm_start_agg(m, x[1] + x[2], x)).kind FROM pf, (SELECT ml_fit_agg('MlpRegressor', x[1] + x[2], x, '{"max_iter": 20}') AS m FROM pf) GROUP BY m;
----
MlpRegressor

# name: test/sql/ml_cv.test
# description: ml_cv_splits_agg: cross-validation splits as a fold table
# group: [anofox_ml]

require anofox_ml

statement ok
SET anofox_telemetry_enabled = false;

statement ok
CREATE TABLE t AS SELECT i AS id, (i % 3 = 0)::DOUBLE AS y, 'c' || (i % 4) AS cust, i::DOUBLE AS a, (2 * i + 1)::DOUBLE AS target
FROM range(12) r(i);

statement ok
CREATE MACRO folds(method, options) AS TABLE
SELECT unnest(ml_cv_splits_agg(id, method, options ORDER BY id), recursive := true) FROM t;

# kfold matches scikit-learn KFold(3)
query II
SELECT split, list(id ORDER BY id) FROM folds('kfold', '{"n_splits": 3}') WHERE role = 'test' GROUP BY split ORDER BY split;
----
0	[0, 1, 2, 3]
1	[4, 5, 6, 7]
2	[8, 9, 10, 11]

# every row appears once per split
query II
SELECT count(*), count(DISTINCT (id, split)) FROM folds('kfold', '{"n_splits": 3}');
----
36	36

# time_series matches scikit-learn TimeSeriesSplit(3, gap=1)
query III
SELECT split, list(id ORDER BY id) FILTER (role = 'test'), max(id) FILTER (role = 'train')
FROM folds('time_series', '{"n_splits": 3, "gap": 1}') GROUP BY split ORDER BY split;
----
0	[3, 4, 5]	1
1	[6, 7, 8]	4
2	[9, 10, 11]	7

# the ORDER BY of the aggregate is the time order
query I
SELECT list(id ORDER BY id) FROM (
    SELECT unnest(ml_cv_splits_agg(id, 'time_series', '{"n_splits": 2}' ORDER BY id DESC), recursive := true) FROM t)
WHERE role = 'test' AND split = 1;
----
[0, 1, 2, 3]

# stratified: every test fold has the same class balance
query I
SELECT list_distinct(list(n)) FROM (
    SELECT split, sum(y) AS n FROM (
        SELECT unnest(ml_cv_splits_agg(id, 'stratified_kfold', '{"n_splits": 2}', y ORDER BY id), recursive := true) FROM t
    ) JOIN t USING (id) WHERE role = 'test' GROUP BY split);
----
[2.0]

# groups never straddle train and test; y may be NULL when unused
query I
SELECT count(*) FROM (
    SELECT split, cust FROM (
        SELECT unnest(ml_cv_splits_agg(id, 'group_kfold', '{"n_splits": 2}', NULL, cust ORDER BY id), recursive := true) FROM t
    ) JOIN t USING (id) GROUP BY split, cust HAVING count(DISTINCT role) > 1);
----
0

# integer groups; rows with a NULL group are left out
query II
SELECT count(DISTINCT split), count(DISTINCT id) FROM (
    SELECT unnest(ml_cv_splits_agg(id, 'leave_one_group_out', '{}', NULL, CASE WHEN id < 10 THEN id % 3 END ORDER BY id),
                  recursive := true) FROM t);
----
3	10

# seeded shuffles are reproducible
query I
SELECT (SELECT list(id ORDER BY id) FROM folds('shuffle_split', '{"n_splits": 2, "test_size": 0.25, "seed": 7}') WHERE role = 'test' AND split = 0)
     = (SELECT list(id ORDER BY id) FROM folds('shuffle_split', '{"n_splits": 2, "test_size": 0.25, "seed": 7}') WHERE role = 'test' AND split = 0);
----
true

# per group
query II
SELECT g, len(ml_cv_splits_agg(id, 'leave_one_out', '{}' ORDER BY id)) FROM (SELECT id % 2 AS g, id FROM t) GROUP BY g ORDER BY g;
----
0	36
1	36

# a full cross-validation loop with ml_fit_agg and a metric
query I
WITH f AS (SELECT * FROM folds('kfold', '{"n_splits": 3}') JOIN t USING (id)),
     m AS (SELECT split, ml_fit_agg('OlsRegressor', target, [a]) AS model FROM f WHERE role = 'train' GROUP BY split)
SELECT max(rmse) < 1e-9 FROM (
    SELECT split, ml_rmse(target, ml_predict(model, [a])) AS rmse FROM f JOIN m USING (split) WHERE role = 'test' GROUP BY split);
----
true

statement error
SELECT ml_cv_splits_agg(id, 'stratified_kfold', '{}' ORDER BY id) FROM t;
----
needs a target

statement error
SELECT ml_cv_splits_agg(id, 'kfold', '{"k": 3}' ORDER BY id) FROM t;
----
unknown field

statement error
SELECT ml_cv_splits_agg(id, 'nope', '{}') FROM t;
----
unknown method

# Purged k-fold: labels span [t, t + 2]; training rows whose label overlaps
# the test span are purged, and `embargo` rows after it are dropped.
statement ok
CREATE TABLE r AS SELECT i AS id, i::DOUBLE AS t0, i + 2.0 AS t1, (2 * i)::DOUBLE AS y FROM range(12) t(i);

query III
SELECT split, list(id ORDER BY id) FILTER (role = 'train'), list(id ORDER BY id) FILTER (role = 'test')
FROM (SELECT unnest(ml_purged_cv_splits_agg(id, t0, t1, 'purged_kfold', '{"n_splits": 3, "embargo": 1}' ORDER BY t0), recursive := true) FROM r)
GROUP BY split ORDER BY split;
----
0	[7, 8, 9, 10, 11]	[0, 1, 2, 3]
1	[0, 1, 11]	[4, 5, 6, 7]
2	[0, 1, 2, 3, 4, 5]	[8, 9, 10, 11]

# no training row's label overlaps its test span
query I
SELECT count(*) FROM (
    SELECT split, id, role FROM (SELECT unnest(ml_purged_cv_splits_agg(id, t0, t1, 'purged_kfold', '{"n_splits": 3}' ORDER BY t0), recursive := true) FROM r)
) s JOIN r USING (id)
WHERE role = 'train' AND EXISTS (
    SELECT 1 FROM (SELECT unnest(ml_purged_cv_splits_agg(id, t0, t1, 'purged_kfold', '{"n_splits": 3}' ORDER BY t0), recursive := true) FROM r) s2
    JOIN r r2 USING (id) WHERE s2.split = s.split AND s2.role = 'test' AND r2.t0 <= r.t1 AND r.t0 <= r2.t1);
----
0

# Combinatorial purged CV: C(4, 2) = 6 splits, C(3, 1) = 3 backtest paths, each covering every row once
query III
SELECT count(DISTINCT split), count(DISTINCT path), bool_and(n = 12 AND d = 12) FROM (
    SELECT split, path, count(*) OVER (PARTITION BY path) AS n, count(DISTINCT id) OVER (PARTITION BY path) AS d, role
    FROM (SELECT unnest(ml_purged_cv_splits_agg(id, t0, t1, 'combinatorial_purged', '{"n_groups": 4, "n_test_groups": 2}' ORDER BY t0), recursive := true) FROM r))
WHERE role = 'test';
----
6	3	true

# training entries have no path
query I
SELECT count(*) FROM (SELECT unnest(ml_purged_cv_splits_agg(id, t0, t1, 'combinatorial_purged', '{"n_groups": 4, "n_test_groups": 2}' ORDER BY t0), recursive := true) FROM r)
WHERE role = 'train' AND path IS NOT NULL;
----
0

# a backtest per path: out-of-sample predictions from the split that owns each row of the path
statement ok
CREATE TABLE r40 AS SELECT i AS id, i::DOUBLE AS t0, i + 2.0 AS t1, (2 * i)::DOUBLE AS y FROM range(40) t(i);

query II
WITH s AS (SELECT unnest(ml_purged_cv_splits_agg(id, t0, t1, 'combinatorial_purged', '{"n_groups": 4, "n_test_groups": 2}' ORDER BY t0), recursive := true) FROM r40),
m AS (SELECT split, ml_fit_agg('OlsRegressor', y, [t0]) AS model FROM s JOIN r40 USING (id) WHERE role = 'train' GROUP BY split)
SELECT count(*), max(rmse) < 1e-9 FROM (
    SELECT path, ml_rmse(y, ml_predict(model, [t0])) AS rmse FROM s JOIN r40 USING (id) JOIN m USING (split) WHERE role = 'test' GROUP BY path);
----
3	true

statement error
SELECT ml_purged_cv_splits_agg(id, t0, t1, 'kfold', '{}' ORDER BY t0) FROM r;
----
unknown method

# Spatial CV on a 10 x 10 grid of points one unit apart.
statement ok
CREATE TABLE grid AS SELECT i AS id, (i % 10)::DOUBLE AS gx, (i // 10)::DOUBLE AS gy, (i % 10 + i // 10)::DOUBLE AS v FROM range(100) t(i);

# 5 x 5 blocks -> 4 blocks; each split tests one whole block
query II
SELECT count(DISTINCT split), bool_and(n = 25) FROM (
    SELECT split, count(*) AS n FROM (
        SELECT unnest(ml_spatial_cv_splits_agg(id, [gx, gy], 'spatial_block_kfold', '{"block_size": 5, "n_splits": 4}' ORDER BY id), recursive := true) FROM grid)
    WHERE role = 'test' GROUP BY split);
----
4	true

# with a buffer, no training point lies within 1.5 of a test point of its split
query I
WITH s AS (SELECT unnest(ml_spatial_cv_splits_agg(id, [gx, gy], 'spatial_block_kfold', '{"block_size": 5, "n_splits": 4, "buffer": 1.5}' ORDER BY id), recursive := true) FROM grid)
SELECT count(*) FROM s a JOIN grid ga ON a.id = ga.id JOIN s b ON a.split = b.split JOIN grid gb ON b.id = gb.id
WHERE a.role = 'train' AND b.role = 'test' AND sqrt((ga.gx - gb.gx) ^ 2 + (ga.gy - gb.gy) ^ 2) <= 1.5;
----
0

# buffered leave-one-out: one split per point, neighbours within the radius left out of training
query II
SELECT count(DISTINCT split), max(n_train) FROM (
    SELECT split, count(*) FILTER (role = 'train') AS n_train FROM (
        SELECT unnest(ml_spatial_cv_splits_agg(id, [gx, gy], 'buffered_loo', '{"buffer": 1.0}' ORDER BY id), recursive := true) FROM grid)
    GROUP BY split);
----
100	97

# haversine distances on [lat, lon]
query I
SELECT count(DISTINCT split) FROM (
    SELECT unnest(ml_spatial_cv_splits_agg(id, [48 + gy / 10, 11 + gx / 10], 'kfold', '{"n_splits": 3, "buffer": 5, "metric": "haversine"}' ORDER BY id), recursive := true) FROM grid);
----
3

statement error
SELECT ml_spatial_cv_splits_agg(id, [gx, gy], 'spatial_block_kfold', '{}') FROM grid;
----
needs block_size

statement error
SELECT ml_spatial_cv_splits_agg(id, [gx, gy, v], 'kfold', '{"buffer": 1, "metric": "haversine"}') FROM grid;
----
haversine needs [latitude, longitude]

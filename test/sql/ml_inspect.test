# name: test/sql/ml_inspect.test
# description: permutation feature importance
# group: [anofox_ml]

require anofox_ml

statement ok
SET anofox_telemetry_enabled = false;

# y depends strongly on a, weakly on b, not at all on noise.
statement ok
CREATE TABLE d AS SELECT i AS id, (i % 20)::DOUBLE AS a, ((i * 7919) % 13)::DOUBLE AS noise, ((i * 31) % 11)::DOUBLE AS b,
    3.0 * (i % 20) + 0.5 * ((i * 31) % 11) AS y, (i % 20 >= 10)::DOUBLE AS c, CASE WHEN i % 20 >= 10 THEN 'high' ELSE 'low' END AS cl
FROM range(400) t(i);

statement ok
CREATE TABLE m AS SELECT ml_fit_agg('OlsRegressor', y, [a, noise, b]) AS model FROM d;

query IIII
SELECT list_transform(imp, lambda s: s.feature),
       imp[1].importance_mean > imp[3].importance_mean,
       imp[3].importance_mean > 0,
       abs(imp[2].importance_mean) < 1e-6
FROM (SELECT ml_permutation_importance_agg(model, y, [a, noise, b], '{"seed": 0}') AS imp FROM d, m GROUP BY model);
----
[1, 2, 3]	true	true	true

# a loss metric is negated, so a useful feature still has a positive importance
query II
SELECT imp[1].importance_mean > 0, abs(imp[2].importance_mean) < 1e-6
FROM (SELECT ml_permutation_importance_agg(model, y, [a, noise, b], '{"metric": "rmse", "n_repeats": 3}') AS imp FROM d, m GROUP BY model);
----
true	true

# seeded: reproducible
query I
SELECT a = b FROM (
    SELECT ml_permutation_importance_agg(model, y, [a, noise, b], '{"seed": 3}') AS a,
           ml_permutation_importance_agg(model, y, [a, noise, b], '{"seed": 3}') AS b FROM d, m GROUP BY model);
----
true

# classifiers: accuracy by default, probability metrics, string labels
query II
SELECT imp[1].importance_mean > 0.3, imp[2].importance_mean = 0
FROM (SELECT ml_permutation_importance_agg(model, c, [a, noise]) AS imp
      FROM d, (SELECT ml_fit_agg('DecisionTreeClassifier', c, [a, noise], '{"max_depth": 1}') AS model FROM d) GROUP BY model);
----
true	true

query II
SELECT imp[1].importance_mean > 0.3, imp[2].importance_mean = 0
FROM (SELECT ml_permutation_importance_agg(model, c, [a, noise], '{"metric": "roc_auc"}') AS imp
      FROM d, (SELECT ml_fit_agg('DecisionTreeClassifier', c, [a, noise], '{"max_depth": 1}') AS model FROM d) GROUP BY model);
----
true	true

query I
SELECT imp[1].importance_mean > 0.3
FROM (SELECT ml_permutation_importance_agg(model, cl, [a, noise], '{"metric": "log_loss"}') AS imp
      FROM d, (SELECT ml_fit_agg('RandomForestClassifier', cl, [a, noise], '{"n_estimators": 10}') AS model FROM d) GROUP BY model);
----
true

statement error
SELECT ml_permutation_importance_agg(model, y, [a, noise, b], '{"repeats": 3}') FROM d, m GROUP BY model;
----
unknown field

# Recursive feature elimination; supports and rankings of scikit-learn 1.9
# RFE(LinearRegression() / LogisticRegression(), ...) on the same data
statement ok
CREATE TABLE rfe AS SELECT *, 3 * x[1] - 2 * x[3] + 0.5 * x[5] + ((i * 31) % 9) / 10.0 AS y FROM (
    SELECT i, [(i % 7)::DOUBLE, ((13 * i) % 11)::DOUBLE, ((i * 7) % 5)::DOUBLE, (i % 3) * 1.0, ((i * 17) % 23) / 5.0, (i % 4) * 0.5] AS x
    FROM range(200) t(i));

query II
SELECT s.support, s.ranking FROM (SELECT ml_rfe_agg('OlsRegressor', y, x, '{}', '{"n_features_to_select": 2}') AS s FROM rfe);
----
[true, false, true, false, false, false]	[1, 5, 1, 3, 2, 4]

query II
SELECT s.support, s.ranking FROM (SELECT ml_rfe_agg('OlsRegressor', y, x, '{}', '{"n_features_to_select": 3, "step": 2}') AS s FROM rfe);
----
[true, false, true, false, true, false]	[1, 3, 1, 2, 1, 3]

query II
SELECT s.support, s.ranking FROM (
    SELECT ml_rfe_agg('LogisticRegressor', CASE WHEN y > m THEN 'hi' ELSE 'lo' END, x, '{}', '{"n_features_to_select": 2}') AS s
    FROM rfe, (SELECT median(y) AS m FROM rfe));
----
[true, false, true, false, false, false]	[1, 5, 1, 4, 2, 3]

# default: keep half; the model is fitted on the selected features, in order
query III
SELECT len(list_filter(s.support, lambda b: b)), ml_model_info(s.model).n_features,
       abs(ml_predict(s.model, list_select(x, list_filter(range(1, 7), lambda j: s.support[j]))) - y) < 5
FROM (SELECT ml_rfe_agg('RandomForestRegressor', y, x, '{"n_estimators": 20, "seed": 0}') AS s FROM rfe), rfe WHERE i = 10;
----
3	3	true

statement error
SELECT ml_rfe_agg('KnnRegressor', y, x) FROM rfe;
----
neither feature_importances nor coefficients

statement error
SELECT ml_rfe_agg('OlsRegressor', y, x, '{}', '{"step": 0}') FROM rfe;
----
step must be a positive count

# k nearest training rows (anofox-ml 0.5): positions in the fit's input order
statement ok
CREATE TABLE nn AS SELECT i, [i::DOUBLE, (i % 3)::DOUBLE] AS x, (i * 2)::DOUBLE AS y FROM range(10) t(i);

query II
SELECT r.indices, list_transform(r.distances, lambda d: round(d, 6)) FROM (
    SELECT ml_kneighbors(ml_fit_agg('KnnRegressor', y, x ORDER BY i), [4.2, 1.0], 3) AS r FROM nn);
----
[4, 5, 3]	[0.2, 1.280625, 1.56205]

# default k: the model's n_neighbors (5); a training row is its own nearest neighbour
query II
SELECT len(r.indices), r.indices[1] FROM (SELECT ml_kneighbors(ml_fit_agg('KnnClassifier', (i % 2)::DOUBLE, x ORDER BY i), [7.0, 1.0]) AS r FROM nn);
----
5	7

statement error
SELECT ml_kneighbors(ml_fit_agg('OlsRegressor', y, x), [1.0, 1.0]) FROM nn;
----
does not support kneighbors

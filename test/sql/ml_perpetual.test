# name: test/sql/ml_perpetual.test
# description: PerpetualBooster kinds (not in the wasm builds: the perpetual crate needs threads)
# group: [anofox_ml]

require anofox_ml

statement ok
SET anofox_telemetry_enabled = false;

# PerpetualBooster (registry feature perpetual): per-group fits, BLOB round trip
# through a table, string labels, and as the base model of CQR
statement ok
CREATE TABLE pb AS SELECT i % 2 AS g, (hash(i) % 1000) / 100.0 AS a, (hash(i, 'b') % 1000) / 100.0 AS b FROM range(600) t(i);

statement ok
CREATE TABLE pb_models AS SELECT g, ml_fit_agg('PerpetualRegressor', 2 * a + b, [a, b], '{"budget": 0.5}') AS m FROM pb GROUP BY g;

query II
SELECT g, abs(ml_predict(m, [3.0, 4.0]) - 10) < 1.5 FROM pb_models ORDER BY g;
----
0	true
1	true

query I
SELECT ml_predict_label(ml_fit_agg('PerpetualClassifier', CASE WHEN a > 5 THEN 'hi' ELSE 'lo' END, [a, b]), [9.0, 1.0]) FROM pb;
----
hi

query I
SELECT pi.lower < 10 AND pi.upper > 10 FROM (SELECT ml_predict_interval(ml_fit_agg('ConformalizedQuantileRegressor', 2 * a + b, [a, b],
    '{"estimator": "PerpetualRegressor", "alpha": 0.1}'), [3.0, 4.0], 0.1) AS pi FROM pb);
----
true

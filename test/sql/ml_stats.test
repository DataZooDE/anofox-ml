# name: test/sql/ml_stats.test
# description: statistic aggregates (mutual information, shrunk covariance, MeanShift bandwidth)
# group: [anofox_ml]

require anofox_ml

statement ok
SET anofox_telemetry_enabled = false;

# scikit-learn: ledoit_wolf(X) / oas(X) with X = [i % 7, (13 i) % 11, 2 (i % 7) + i % 3], i < 50
query IIII
SELECT round(c.shrinkage, 12), round(c.covariance[1][1], 12), round(c.covariance[1][3], 12), len(c.covariance)
FROM (SELECT ml_covariance_agg([(i % 7)::DOUBLE, ((i * 13) % 11)::DOUBLE, (i % 7) * 2.0 + (i % 3)]) AS c FROM range(50) t(i));
----
0.078839847601	4.599072356324	7.564198707441	3

query III
SELECT round(c.shrinkage, 12), round(c.covariance[1][1], 12), round(c.covariance[1][3], 12)
FROM (SELECT ml_covariance_agg([(i % 7)::DOUBLE, ((i * 13) % 11)::DOUBLE, (i % 7) * 2.0 + (i % 3)], '{"method": "oas"}') AS c FROM range(50) t(i));
----
0.136950017191	4.969575049608	7.087021238833

# empirical (maximum likelihood) covariance: variance of 0..9 is 8.25
query II
SELECT c.covariance, c.shrinkage FROM (SELECT ml_covariance_agg([i::DOUBLE], '{"method": "empirical"}') AS c FROM range(10) t(i));
----
[[8.25]]	0.0

# scikit-learn: estimate_bandwidth on a 10 x 10 grid, quantile 0.3
query I
SELECT round(ml_estimate_bandwidth_agg([(i % 10)::DOUBLE, (i // 10)::DOUBLE]), 6) FROM range(100) t(i);
----
3.833107

# mutual information: informative feature > 0, noise = 0; continuous and string targets
query II
SELECT mi[1] > 1, mi[2] = 0 FROM (SELECT ml_mutual_info_agg((i % 30) * 2.0, [(i % 30)::DOUBLE, ((i * 7919) % 13)::DOUBLE] ORDER BY i) AS mi FROM range(300) t(i));
----
true	true

query II
SELECT mi[1] > 0.5, mi[2] < 0.05 FROM (SELECT ml_mutual_info_agg(CASE WHEN i % 30 < 15 THEN 'a' ELSE 'b' END, [(i % 30)::DOUBLE, ((i * 7919) % 13)::DOUBLE] ORDER BY i) AS mi FROM range(300) t(i));
----
true	true

# discrete features by position
query I
SELECT len(ml_mutual_info_agg((i % 4)::DOUBLE, [(i % 4)::DOUBLE, (i % 3)::DOUBLE], '{"discrete_target": true, "discrete_features": [1, 2]}')) FROM range(120) t(i);
----
2

# per group; empty groups give NULL
query II
SELECT g, ml_covariance_agg([v]).covariance FROM (VALUES (1, 1.0), (1, 3.0), (2, 5.0)) t(g, v) GROUP BY g ORDER BY g;
----
1	[[1.0]]
2	[[0.0]]

query I
SELECT ml_estimate_bandwidth_agg([v]) FROM (VALUES (1.0)) t(v) WHERE false;
----
NULL

statement error
SELECT ml_covariance_agg([i::DOUBLE], '{"method": "robust"}') FROM range(10) t(i);
----
method must be

statement error
SELECT ml_mutual_info_agg(i::DOUBLE, [i::DOUBLE], '{"discrete_features": [3]}') FROM range(10) t(i);
----
not a feature position

# Spectral embedding: two triangles joined by one edge (scikit-learn spectral_embedding, n_components=1)
query II
SELECT node, round(embedding[1], 8) FROM (
    SELECT unnest(ml_spectral_embedding_agg(a, b, 1.0, '{"n_components": 1}'), recursive := true)
    FROM (VALUES (1, 2), (2, 3), (1, 3), (10, 11), (11, 12), (10, 12), (3, 10)) t(a, b))
ORDER BY node;
----
1	0.31476238
2	0.31476238
3	0.18591984
10	-0.18591984
11	-0.31476238
12	-0.31476238

# default 2 components, unit weights, per group
query II
SELECT g, list_bool_and([len(e.embedding) = 2 for e in emb]) FROM (
    SELECT g, ml_spectral_embedding_agg(a, b) AS emb
    FROM (VALUES (1, 1, 2), (1, 2, 3), (1, 3, 4), (1, 4, 1), (2, 5, 6), (2, 6, 7), (2, 7, 8), (2, 8, 5)) t(g, a, b) GROUP BY g)
ORDER BY g;
----
1	true
2	true

# scikit-learn 1.9: ShrunkCovariance(shrinkage=0.1) and MinCovDet(random_state=0)
# on the same X; location_ alongside
query IIII
SELECT c.covariance[1][1], c.covariance[1][3], c.location[2], c.shrinkage
FROM (SELECT ml_covariance_agg([(i % 7)::DOUBLE, ((i * 13) % 11)::DOUBLE, (i % 7) * 2.0 + (i % 3)], '{"method": "shrunk"}') AS c FROM range(50) t(i));
----
4.733986666666666	7.390440000000003	5.0	0.1

query IIIII
SELECT round(c.covariance[1][1], 12), round(c.covariance[1][3], 12), round(c.location[1], 12), round(c.location[3], 12), c.shrinkage IS NULL
FROM (SELECT ml_covariance_agg([(i % 7)::DOUBLE, ((i * 13) % 11)::DOUBLE, (i % 7) * 2.0 + (i % 3)], '{"method": "mcd"}') AS c FROM range(50) t(i));
----
3.631002743805	7.874014172076	3.470588235294	7.735294117647	true

query I
SELECT c.location FROM (SELECT ml_covariance_agg([i::DOUBLE], '{"method": "empirical"}') AS c FROM range(10) t(i));
----
[4.5]

statement error
SELECT ml_covariance_agg([i::DOUBLE], '{"method": "oas", "shrinkage": 0.5}') FROM range(10) t(i);
----
shrinkage applies to method "shrunk"

# Fitted covariance models: ml_covariance gives what ml_covariance_agg gives;
# ml_mahalanobis is the squared distance (location itself: 0)
query III
SELECT round(f.covariance[1][3] - a.covariance[1][3], 12), round(f.location[2] - a.location[2], 12),
       round(list_sum(list_transform(range(1, 4), lambda r: list_sum(list_transform(range(1, 4), lambda c: f.covariance[r][c] * f.precision[c][r])))), 9)
FROM (SELECT ml_covariance(ml_fit_agg('MinCovDet', x)) AS f, ml_covariance_agg(x, '{"method": "mcd"}') AS a
      FROM (SELECT [(i % 7)::DOUBLE, ((i * 13) % 11)::DOUBLE, (i % 7) * 2.0 + (i % 3)] AS x FROM range(50) t(i)));
----
0.0	0.0	3.0

query II
SELECT round(ml_mahalanobis(m, ml_covariance(m).location), 12), ml_mahalanobis(m, [100.0, 0.0, 0.0]) > 100
FROM (SELECT ml_fit_agg('LedoitWolf', [(i % 7)::DOUBLE, ((i * 13) % 11)::DOUBLE, (i % 7) * 2.0 + (i % 3)]) AS m FROM range(50) t(i));
----
0.0	true

query I
SELECT len(ml_covariance(ml_fit_agg('EllipticEnvelope', [(i % 7)::DOUBLE, ((i * 13) % 11)::DOUBLE])).covariance) FROM range(50) t(i);
----
2

statement error
SELECT ml_covariance(ml_fit_agg('OlsRegressor', i::DOUBLE, [i::DOUBLE])) FROM range(10) t(i);
----
has no location

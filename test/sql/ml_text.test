# name: test/sql/ml_text.test
# description: hashing vectorizer (scikit-learn HashingVectorizer)
# group: [anofox_ml]

require anofox_ml

statement ok
SET anofox_telemetry_enabled = false;

# scikit-learn: HashingVectorizer(n_features=16).transform([doc])
query II
SELECT s.indices, list_bool_and(list_transform(list_zip(s.values, [0.242535625036, -0.485071250073, 0.242535625036, 0.242535625036, 0.242535625036, -0.727606875109]), p -> abs(p[1] - p[2]) < 1e-9))
FROM (SELECT ml_hashing_vectorize_sparse('The quick brown fox jumps over the lazy dog the end', 16) AS s);
----
[0, 7, 9, 11, 13, 14]	true

# raw counts
query I
SELECT ml_hashing_vectorize_sparse('The quick brown fox jumps over the lazy dog the end', 16, '{"alternate_sign": false, "norm": null}');
----
{'indices': [0, 5, 7, 9, 11, 13, 14], 'values': [1.0, 2.0, 2.0, 1.0, 1.0, 1.0, 3.0]}

# dense: same values at the same (1-based) positions
query II
SELECT len(d), d[15] = s.values[6]
FROM (SELECT ml_hashing_vectorize('The quick brown fox jumps over the lazy dog the end', 16) AS d,
             ml_hashing_vectorize_sparse('The quick brown fox jumps over the lazy dog the end', 16) AS s);
----
16	true

# single-character tokens are dropped, as with scikit-learn's default token pattern
query I
SELECT list_sum(ml_hashing_vectorize('a b c', 8, '{"norm": null}'));
----
0.0

query I
SELECT ml_hashing_vectorize(NULL, 8) IS NULL;
----
true

# a tiny text classifier on hashed features
query I
WITH docs AS (SELECT * FROM (VALUES
    ('cheap pills buy now', 'spam'), ('buy cheap watches now', 'spam'), ('win money now', 'spam'),
    ('meeting agenda attached', 'ham'), ('lunch tomorrow with team', 'ham'), ('project meeting notes', 'ham')) t(text, label)),
m AS (SELECT ml_fit_agg('MultinomialNB', label, ml_hashing_vectorize(text, 64, '{"alternate_sign": false}')) AS model FROM docs)
SELECT ml_predict_label(model, ml_hashing_vectorize('buy cheap now', 64, '{"alternate_sign": false}')) FROM m;
----
spam

statement error
SELECT ml_hashing_vectorize('x y', 0);
----
n_features must be positive

statement error
SELECT ml_hashing_vectorize('xx yy', 8, '{"norm": "l1"}');
----
norm must be

# TF-IDF on hashed counts: scikit-learn 1.9 HashingVectorizer(n_features=64,
# alternate_sign=False, norm=None) + TfidfTransformer() gives
# [(6, 0.6451024322949592), (58, 0.764096101185661)] for 'win money'
statement ok
CREATE TABLE mails AS SELECT * FROM (VALUES ('win money now', 'spam'), ('cheap money win', 'spam'), ('meeting at noon', 'ham'),
    ('lunch meeting tomorrow', 'ham'), ('win a cheap prize', 'spam'), ('project meeting notes', 'ham')) t(body, label);

query I
SELECT list_filter(list_zip(range(0, 64), v), lambda p: p[2] <> 0) FROM (
    SELECT ml_transform(ml_fit_agg('TfidfTransformer', ml_hashing_vectorize(body, 64, '{"alternate_sign": false, "norm": null}')),
                        ml_hashing_vectorize('win money', 64, '{"alternate_sign": false, "norm": null}')) AS v FROM mails);
----
[(6, 0.6451024322949592), (58, 0.764096101185661)]

query II
WITH tf AS (SELECT ml_fit_agg('TfidfTransformer', ml_hashing_vectorize(body, 64, '{"alternate_sign": false, "norm": null}')) AS idf FROM mails),
     m AS (SELECT idf, ml_fit_agg('LinearSvc', label, ml_transform(idf, ml_hashing_vectorize(body, 64, '{"alternate_sign": false, "norm": null}'))) AS model
           FROM mails, tf GROUP BY idf)
SELECT body, ml_predict_label(model, ml_transform(idf, ml_hashing_vectorize(body, 64, '{"alternate_sign": false, "norm": null}')))
FROM (VALUES ('cheap money'), ('meeting tomorrow')) n(body), m ORDER BY body;
----
cheap money	spam
meeting tomorrow	ham
